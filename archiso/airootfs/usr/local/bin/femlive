#!/usr/bin/env bash
# ==============================================================================
# femlive: Launch FemboyOS Pink Hyprland GUI, Pink Waybar & Astolfo Wallpaper
# Fixes:
#   1. Removes ~/.config/hypr/hyprland.lua so Hyprland 0.56 never ignores .conf
#   2. Stops seatd conflict and forces LIBSEAT_BACKEND=logind (fixes exit 134)
#   3. 3-stage VMware GPU fallback (Hardware DRM -> Software llvmpipe -> Cage KMS)
# License: FemboyOS Source-Available License v1.0 (BY-NC-NOEDU-NOMED)
# ==============================================================================
set -uo pipefail

WALLPAPER="/usr/share/backgrounds/femboyos/astolfo_bsod_gtx750.jpg"
HYPR_DIR="${HOME}/.config/hypr"
CUSTOM_CONF="${HYPR_DIR}/custom/femboy_pink.conf"

echo -e "\033[1;35m[*] Starting femlive - FemboyOS Pink Hyprland Session...\033[0m"

# 1. Ensure XDG_RUNTIME_DIR exists with strict 0700 permissions
UID_NUM="$(id -u)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${UID_NUM}}"
mkdir -p "${XDG_RUNTIME_DIR}"
chown "${UID_NUM}:${UID_NUM}" "${XDG_RUNTIME_DIR}" 2>/dev/null || true
chmod 0700 "${XDG_RUNTIME_DIR}"

# 2. Fix libseat / seatd conflict (systemd-logind already owns tty1 drmMaster!)
if command -v systemctl >/dev/null 2>&1; then
    systemctl stop seatd.service seatd.socket 2>/dev/null || true
fi
rm -f /run/seatd.sock 2>/dev/null || true
export LIBSEAT_BACKEND=logind

# 3. CRITICAL: Remove any hyprland.lua files so Hyprland 0.56 NEVER ignores our .conf!
mkdir -p "${HYPR_DIR}/custom" "${HOME}/.config/waybar" "${HOME}/.config/kitty"
rm -f "${HYPR_DIR}"/*.lua /root/.config/hypr/*.lua /etc/skel/.config/hypr/*.lua 2>/dev/null || true

# 4. Write clean Hyprland 0.56 Pink Config
cat << 'PINK_CONF_EOF' > "${CUSTOM_CONF}"
env = WLR_NO_HARDWARE_CURSORS,1
env = WLR_RENDERER_ALLOW_SOFTWARE,1
env = AQ_NO_MODIFIERS,1
env = AQ_NO_ATOMIC,1
env = AQ_MGPU_NO_EXPLICIT,1

monitor = ,preferred,auto,1

debug {
    disable_logs = false
    enable_stdout_logs = true
}

cursor {
    no_hardware_cursors = true
}

render {
    explicit_sync = 0
    explicit_sync_kms = 0
    direct_scanout = false
}

ecosystem {
    no_update_news = true
    no_donation_nag = true
}

input {
    kb_layout = us,ru
    kb_options = grp:alt_shift_toggle
    follow_mouse = 1
}

general {
    gaps_in = 6
    gaps_out = 12
    border_size = 3
    col.active_border = rgba(ff69b4ff) rgba(ffb1c8ff) rgba(ff1493ff) 45deg
    col.inactive_border = rgba(4a2538aa)
    layout = dwindle
}

decoration {
    rounding = 18
    active_opacity = 0.94
    inactive_opacity = 0.86
    blur {
        enabled = true
        size = 8
        passes = 3
    }
    shadow {
        enabled = true
        range = 24
        render_power = 3
        color = rgba(ff69b466)
        color_inactive = rgba(1f101844)
    }
}

animations {
    enabled = true
    bezier = femboyBounce, 0.05, 0.9, 0.1, 1.08
    bezier = softPink, 0.25, 1.0, 0.5, 1.0
    animation = windows, 1, 5, femboyBounce, popin 80%
    animation = border, 1, 10, softPink
    animation = fade, 1, 5, softPink
    animation = workspaces, 1, 6, femboyBounce, slidevert
}

bind = SUPER, Return, exec, kitty
bind = SUPER, Q, exec, kitty
bind = SUPER, D, exec, fuzzel
bind = SUPER, R, exec, fuzzel
bind = SUPER, I, exec, kitty -e feminstall
bind = SUPER, C, killactive,
bind = SUPER, M, exit,
bind = SUPER, V, togglefloating,
bind = SUPER, F, fullscreen,
bind = SUPER, 1, workspace, 1
bind = SUPER, 2, workspace, 2
bind = SUPER, 3, workspace, 3
bind = SUPER, 4, workspace, 4
bind = SUPER, 5, workspace, 5
bindm = SUPER, mouse:272, movewindow
bindm = SUPER, mouse:273, resizewindow

exec-once = swaybg -i /usr/share/backgrounds/femboyos/astolfo_bsod_gtx750.jpg -m fill
exec-once = awww-daemon --format xrgb && awww img /usr/share/backgrounds/femboyos/astolfo_bsod_gtx750.jpg --transition-type grow --transition-pos 0.85,0.85 --transition-duration 1.5
exec-once = waybar
exec-once = kitty
PINK_CONF_EOF
cp -f "${CUSTOM_CONF}" "${HYPR_DIR}/hyprland.conf"

# 5. Write Pink Waybar & Kitty configuration so the UI is 100% Pink out of the box
cat << 'WAYBAR_CFG_EOF' > "${HOME}/.config/waybar/config.jsonc"
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "modules-left": ["custom/femboy", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/installer", "cpu", "memory", "network"],
    "custom/femboy": {
        "format": "  FemboyOS Pink ",
        "on-click": "fuzzel"
    },
    "custom/installer": {
        "format": " [Install OS: feminstall] ",
        "on-click": "kitty -e feminstall"
    },
    "clock": {
        "format": "{:%H:%M  %Y-%m-%d}"
    },
    "cpu": {
        "format": "CPU {usage}%"
    },
    "memory": {
        "format": "RAM {}%"
    },
    "network": {
        "format-wifi": "NET {essid}",
        "format-ethernet": "NET Online",
        "format-disconnected": "Offline"
    }
}
WAYBAR_CFG_EOF

cat << 'WAYBAR_CSS_EOF' > "${HOME}/.config/waybar/style.css"
* {
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 13px;
    font-weight: bold;
}
window#waybar {
    background: rgba(31, 16, 24, 0.88);
    border: 2px solid #ff69b4;
    border-radius: 14px;
    color: #ffd9e2;
}
#custom-femboy {
    background: #ff69b4;
    color: #1a0f16;
    border-radius: 10px;
    padding: 0 10px;
    margin: 4px;
}
#custom-installer {
    background: #ffb1c8;
    color: #1a0f16;
    border-radius: 10px;
    padding: 0 10px;
    margin: 4px;
}
#workspaces button {
    color: #ffb1c8;
    padding: 0 8px;
}
#workspaces button.active {
    background: #ff1493;
    color: #ffffff;
    border-radius: 8px;
}
#clock, #cpu, #memory, #network {
    padding: 0 10px;
    color: #ffd9e2;
}
WAYBAR_CSS_EOF

cat << 'KITTY_EOF' > "${HOME}/.config/kitty/kitty.conf"
font_family      JetBrainsMono Nerd Font
font_size        11.0
background_opacity 0.90
background       #1a0f16
foreground       #ffd9e2
cursor           #ff69b4
selection_background #ff69b4
selection_foreground #1a0f16
color0  #1f1018
color1  #ff5577
color2  #ffb1c8
color3  #f4b8e4
color4  #ff69b4
color5  #ff1493
color6  #ffc0cb
color7  #ffd9e2
KITTY_EOF

# 6. Export Wayland, Aquamarine & VMware Workstation GPU compatibility variables
export AQ_NO_MODIFIERS=1
export AQ_NO_ATOMIC=1
export AQ_MGPU_NO_EXPLICIT=1
export WLR_DRM_NO_MODIFIERS=1
export WLR_NO_HARDWARE_CURSORS=1
export WLR_RENDERER_ALLOW_SOFTWARE=1
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND="wayland,x11"
export MOZ_ENABLE_WAYLAND=1

HYPR_FLAGS=(-c "${CUSTOM_CONF}")
if [ "${UID_NUM}" -eq 0 ]; then
    HYPR_FLAGS+=(--i-am-really-stupid)
fi

run_hypr() {
    if command -v dbus-run-session >/dev/null 2>&1; then
        dbus-run-session -- Hyprland "${HYPR_FLAGS[@]}"
    else
        Hyprland "${HYPR_FLAGS[@]}"
    fi
}

# Stage 1: Try with software OpenGL enabled automatically if running inside VMware without 3D render node
if [ ! -e /dev/dri/renderD128 ] || grep -qi "vmware" /sys/class/dmi/id/product_name 2>/dev/null; then
    echo -e "\033[1;35m[*] VMware detected — enabling Mesa software OpenGL/EGL (llvmpipe) for vmwgfx...\033[0m"
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=llvmpipe
fi

run_hypr
EXIT_CODE=$?

# Stage 2: If Stage 1 crashed (e.g. exit code 134), retry with full software GL + cage Pixman KMS bridge
if [ "${EXIT_CODE}" -ne 0 ]; then
    echo -e "\033[1;33m[!] Direct DRM exited with code ${EXIT_CODE}. Retrying with software OpenGL (llvmpipe)...\033[0m"
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=llvmpipe
    export EGL_PLATFORM=gbm
    run_hypr
    EXIT_CODE=$?
fi

if [ "${EXIT_CODE}" -ne 0 ] && command -v cage >/dev/null 2>&1; then
    echo -e "\033[1;35m[*] Launching via Cage Pixman KMS bridge for unaccelerated VMware framebuffer...\033[0m"
    unset EGL_PLATFORM
    export WLR_RENDERER=pixman
    export WLR_NO_HARDWARE_CURSORS=1
    exec dbus-run-session -- cage -d -s -- Hyprland "${HYPR_FLAGS[@]}"
fi

exit "${EXIT_CODE}"
