#!/usr/bin/env bash
# ==============================================================================
# femlive: Launch FemboyOS Pink Hyprland GUI, Quickshell Widgets & Astolfo BSOD
# Wallpaper (with full VMware / QEMU / Bare-Metal GPU compatibility)
# License: FemboyOS Source-Available License v1.0 (BY-NC-NOEDU-NOMED)
# ==============================================================================
set -euo pipefail

WALLPAPER="/usr/share/backgrounds/femboyos/astolfo_bsod_gtx750.jpg"
HYPR_DIR="${HOME}/.config/hypr"
CUSTOM_CONF="${HYPR_DIR}/custom/femboy_pink.conf"

echo -e "\033[1;35m[*] Starting femlive — FemboyOS Pink Hyprland Session...\033[0m"

# 1. Ensure user config directory has the FemboyOS Pink configuration from /etc/skel
if [ ! -d "${HYPR_DIR}" ] && [ -d /etc/skel/.config/hypr ]; then
    mkdir -p "${HOME}/.config"
    cp -r /etc/skel/.config/* "${HOME}/.config/"
fi

mkdir -p "${HYPR_DIR}/custom"
if [ ! -f "${CUSTOM_CONF}" ] && [ -f /etc/skel/.config/hypr/custom/femboy_pink.conf ]; then
    cp /etc/skel/.config/hypr/custom/femboy_pink.conf "${CUSTOM_CONF}"
fi

if [ ! -f "${HYPR_DIR}/hyprland.conf" ]; then
    echo "source = ~/.config/hypr/custom/femboy_pink.conf" > "${HYPR_DIR}/hyprland.conf"
elif ! grep -q "femboy_pink.conf" "${HYPR_DIR}/hyprland.conf"; then
    echo "" >> "${HYPR_DIR}/hyprland.conf"
    echo "source = ~/.config/hypr/custom/femboy_pink.conf" >> "${HYPR_DIR}/hyprland.conf"
fi

# 2. Export Wayland & Virtual GPU environment variables (VMware / KVM / Bare Metal)
export WLR_NO_HARDWARE_CURSORS=1
export WLR_RENDERER_ALLOW_SOFTWARE=1
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND="wayland,x11"
export MOZ_ENABLE_WAYLAND=1

# 3. Launch Hyprland (which triggers awww/swww wallpaper daemon + end-4 widgets)
exec Hyprland
