#!/usr/bin/env bash
# ==============================================================================
# feminstall: Pseudo-Graphical (TUI) Pink Installer for FemboyOS
# Replaces archinstall completely. Installs FemboyOS + Hyprland Pink Edition +
# Astolfo GTX 750 BSOD Wallpaper + femlive by default.
# (Pure ASCII English UI so 100% of characters render cleanly on tty1!)
# License: FemboyOS Source-Available License v1.0 (BY-NC-NOEDU-NOMED)
# ==============================================================================
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo -e "\033[1;35m[feminstall] Elevating privileges via sudo...\033[0m"
    exec sudo "$0" "$@"
fi

export DIALOGRC="/tmp/feminstall_dialogrc"
cat << 'EOF' > "${DIALOGRC}"
use_shadow = ON
use_colors = ON
screen_color = (MAGENTA,BLACK,ON)
shadow_color = (BLACK,BLACK,ON)
dialog_color = (WHITE,BLACK,OFF)
title_color = (LIGHTMAGENTA,BLACK,ON)
border_color = (MAGENTA,BLACK,ON)
button_active_color = (WHITE,MAGENTA,ON)
button_inactive_color = (MAGENTA,BLACK,OFF)
button_key_active_color = (WHITE,MAGENTA,ON)
button_key_inactive_color = (LIGHTMAGENTA,BLACK,ON)
button_label_active_color = (WHITE,MAGENTA,ON)
button_label_inactive_color = (WHITE,BLACK,ON)
inputbox_color = (WHITE,BLACK,OFF)
inputbox_border_color = (MAGENTA,BLACK,ON)
menubox_color = (WHITE,BLACK,OFF)
menubox_border_color = (MAGENTA,BLACK,ON)
item_color = (WHITE,BLACK,OFF)
item_selected_color = (WHITE,MAGENTA,ON)
tag_color = (LIGHTMAGENTA,BLACK,ON)
tag_selected_color = (WHITE,MAGENTA,ON)
tag_key_color = (LIGHTMAGENTA,BLACK,ON)
tag_key_selected_color = (WHITE,MAGENTA,ON)
check_color = (WHITE,BLACK,OFF)
check_selected_color = (WHITE,MAGENTA,ON)
gauge_color = (LIGHTMAGENTA,BLACK,ON)
border2_color = (MAGENTA,BLACK,ON)
inputbox_border2_color = (MAGENTA,BLACK,ON)
menubox_border2_color = (MAGENTA,BLACK,ON)
EOF

BACKTITLE="FemboyOS Pink Installer (feminstall v3.0 - 100% FemboyOS)"

dialog --backtitle "${BACKTITLE}" \
    --title " [ Welcome to FemboyOS Pink Installer ] " \
    --yes-label "Start Install" --no-label "Exit" \
    --yesno "\nWelcome to the feminstall TUI installer!\n\nBy default, the following components will be installed to your disk:\n  * FemboyOS Pink Edition Kernel & Core System\n  * Hyprland + Pink Theme + Pink Waybar & Kitty\n  * Default Astolfo GTX 750 BSOD Wallpaper\n  * 'femlive' command to launch the full Pink GUI & Wallpaper\n  * Windows 7/10 (.exe) Subsystem without Wine/Proton\n\nContinue with FemboyOS disk installation?" 18 72

mapfile -t DISKS < <(lsblk -d -n -p -o NAME,SIZE,MODEL -e 7,11 | awk '{print $1 "\n" $2 "_" $3}')
if [ "${#DISKS[@]}" -eq 0 ]; then
    dialog --backtitle "${BACKTITLE}" --title " Error " --msgbox "No target hard disks found for installation!" 8 50
    exit 1
fi

TARGET_DISK=$(dialog --backtitle "${BACKTITLE}" \
    --title " [ Step 1/4: Select Target Disk ] " \
    --menu "\nSelect target disk (ALL DATA ON THIS DISK WILL BE ERASED):" 15 70 6 \
    "${DISKS[@]}" 3>&1 1>&2 2>&3)

HOSTNAME=$(dialog --backtitle "${BACKTITLE}" \
    --title " [ Step 2/4: System Hostname ] " \
    --inputbox "\nEnter hostname for your FemboyOS machine:" 10 60 "femboyos" 3>&1 1>&2 2>&3)

USERNAME=$(dialog --backtitle "${BACKTITLE}" \
    --title " [ Step 3/4: Username ] " \
    --inputbox "\nEnter username (will be added to wheel/sudo):" 10 60 "astolfo" 3>&1 1>&2 2>&3)

USERPASS=$(dialog --backtitle "${BACKTITLE}" \
    --title " [ Step 4/4: Password for ${USERNAME} ] " \
    --insecure --passwordbox "\nEnter password for ${USERNAME} and root:" 10 60 "femboy" 3>&1 1>&2 2>&3)

AUTO_GUI=$(dialog --backtitle "${BACKTITLE}" \
    --title " [ GUI Launch Mode (femlive) ] " \
    --menu "\nHow should Pink Hyprland start after installation?" 13 72 2 \
    "manual" "Start manually by typing 'femlive' (Recommended)" \
    "auto"   "Automatically start 'femlive' on login" 3>&1 1>&2 2>&3)

dialog --backtitle "${BACKTITLE}" \
    --title " [ Confirm Disk Partitioning ] " \
    --yes-label "Format & Install" --no-label "Cancel" \
    --yesno "\nTarget Disk: ${TARGET_DISK}\nSystem:      FemboyOS (${HOSTNAME})\nUser:        ${USERNAME}\nDesktop:     Hyprland Pink + Astolfo BSOD (femlive)\n\nWARNING: ${TARGET_DISK} will be completely formatted! Proceed?" 15 70

clear
echo -e "\033[1;35m======================================================================"
echo -e "  [feminstall] Installing FemboyOS to ${TARGET_DISK}..."
echo -e "======================================================================\033[0m"

umount -R /mnt 2>/dev/null || true
wipefs -af "${TARGET_DISK}"
sgdisk -Z "${TARGET_DISK}"
sgdisk -n 1:0:+2M   -t 1:ef02 -c 1:"BIOS_BOOT" "${TARGET_DISK}"
sgdisk -n 2:0:+512M -t 2:ef00 -c 2:"FEMBOY_EFI" "${TARGET_DISK}"
sgdisk -n 3:0:0     -t 3:8300 -c 3:"FEMBOY_ROOT" "${TARGET_DISK}"
partprobe "${TARGET_DISK}" || true
sleep 2

if [[ "${TARGET_DISK}" =~ "nvme" ]] || [[ "${TARGET_DISK}" =~ "mmcblk" ]]; then
    PART_EFI="${TARGET_DISK}p2"
    PART_ROOT="${TARGET_DISK}p3"
else
    PART_EFI="${TARGET_DISK}2"
    PART_ROOT="${TARGET_DISK}3"
fi

mkfs.fat -F32 -n FEMBOY_EFI "${PART_EFI}"
mkfs.ext4 -F -L FEMBOY_ROOT "${PART_ROOT}"

mount "${PART_ROOT}" /mnt
mkdir -p /mnt/boot/efi
mount "${PART_EFI}" /mnt/boot/efi

echo -e "\033[1;35m[*] Copying FemboyOS, Hyprland, Pink Config & Wallpaper to disk...\033[0m"
rsync -aAXH --info=progress2 \
    --exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found"} \
    / /mnt/

for KPATH in /run/archiso/bootmnt/arch/boot/x86_64/vmlinuz-linux /boot/vmlinuz-linux; do
    if [ -f "${KPATH}" ]; then
        cp -f "${KPATH}" /mnt/boot/vmlinuz-linux
        break
    fi
done

genfstab -U /mnt > /mnt/etc/fstab

cat << CHROOT_EOF | arch-chroot /mnt /bin/bash
set -euo pipefail

echo "${HOSTNAME}" > /etc/hostname
cat << 'HOSTS_EOF' > /etc/hosts
127.0.0.1   localhost ${HOSTNAME}
::1         localhost ${HOSTNAME}
HOSTS_EOF

printf 'FemboyOS Pink Edition \\r (\\l)\n\n' > /etc/issue

cat << 'OSREL_EOF' > /usr/lib/os-release
NAME="FemboyOS"
PRETTY_NAME="FemboyOS Pink Edition"
ID=femboyos
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;255;105;180"
HOME_URL="https://github.com/femboyos/femboyos"
DOCUMENTATION_URL="https://github.com/femboyos/femboyos"
SUPPORT_URL="https://github.com/femboyos/femboyos"
BUG_REPORT_URL="https://github.com/femboyos/femboyos"
LOGO=femboyos
OSREL_EOF
ln -sf ../usr/lib/os-release /etc/os-release

ln -sf /usr/share/zoneinfo/UTC /etc/localtime
hwclock --systohc || true

rm -f /etc/mkinitcpio.conf.d/archiso.conf
rm -f /etc/systemd/system/getty@tty1.service.d/autologin.conf
rm -f /root/.zlogin /root/.automated_script.sh /usr/local/bin/Installation_guide
rm -f /root/.config/hypr/*.lua /etc/skel/.config/hypr/*.lua

if ! id "${USERNAME}" >/dev/null 2>&1; then
    useradd -m -G wheel,libvirt,kvm,video,audio,input -s /bin/zsh "${USERNAME}"
fi
echo "${USERNAME}:${USERPASS}" | chpasswd
echo "root:${USERPASS}" | chpasswd
echo "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/99-femboyos

cp -rT /etc/skel "/home/${USERNAME}"
cp -rT /etc/skel /root
rm -f "/home/${USERNAME}/.config/hypr/"*.lua /root/.config/hypr/*.lua 2>/dev/null || true

if [ "${AUTO_GUI}" = "auto" ]; then
    cat << 'ZEOF' > "/home/${USERNAME}/.zprofile"
if [ -z "\${DISPLAY:-}" ] && [ "\${XDG_VTNR:-0}" -eq 1 ]; then
    exec femlive
fi
ZEOF
    cp "/home/${USERNAME}/.zprofile" "/home/${USERNAME}/.bash_profile"
fi
chown -R "${USERNAME}:${USERNAME}" "/home/${USERNAME}"

mkinitcpio -P

grub-install --target=i386-pc --recheck "${TARGET_DISK}" || true
if [ -d /sys/firmware/efi ]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=FemboyOS --removable --recheck || true
fi

sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="FemboyOS"/' /etc/default/grub || true
grub-mkconfig -o /boot/grub/grub.cfg
sed -i 's/Arch Linux/FemboyOS/g' /boot/grub/grub.cfg || true
sed -i '1i set color_normal=light-magenta/black\nset color_highlight=white/magenta\n' /boot/grub/grub.cfg || true
CHROOT_EOF

umount -R /mnt || true

dialog --backtitle "${BACKTITLE}" \
    --title " [ FemboyOS Installation Complete! ] " \
    --msgbox "\nFemboyOS has been installed to ${TARGET_DISK}!\n\n  * Login user: ${USERNAME}\n  * Launch Pink Hyprland & Wallpaper: femlive\n\nYou can now reboot and remove the installation ISO." 14 68
clear
echo -e "\033[1;35m[+] FemboyOS installation complete! Type 'reboot' to restart.\033[0m"
